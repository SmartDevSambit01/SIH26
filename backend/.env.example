# NVIDIA NIM (build.nvidia.com) credentials for the AI risk-explanation service.
# Get a free API key at https://build.nvidia.com/ (any preview NIM model), then
# copy this file to backend/.env and paste your real key below. backend/.env is
# gitignored and is never committed.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
